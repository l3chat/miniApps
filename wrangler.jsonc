{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miniapps",
  "main": "./worker-src/index.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/zoom-sum-game/api/*"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ]
}
